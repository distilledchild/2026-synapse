+hdiutil makehybrid -hfs -hfs-volume-name 'Synapse 0.1.0' -o "$stage-volume.dmg" "$stage"
+hdiutil convert "$stage-volume.dmg" -format UDZO -ov -o "$build_root/Synapse-0.1.0-arm64.dmg"
+hdiutil verify "$build_root/Synapse-0.1.0-arm64.dmg"
